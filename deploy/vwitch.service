[Unit]
Description=vwitch egress switch for AmneziaWG
Documentation=https://github.com/sseewald/vwitch
After=network-online.target nftables.service
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/vwitch serve
ExecReload=/bin/kill -HUP $MAINPID
Restart=always
RestartSec=3
RuntimeDirectory=vwitch
RuntimeDirectoryMode=0700
StateDirectory=vwitch
StateDirectoryMode=0700
ConfigurationDirectory=vwitch
ConfigurationDirectoryMode=0700
# vwitch manages interfaces, routes and nftables: root with network caps only
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW CAP_NET_BIND_SERVICE CAP_DAC_OVERRIDE
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_RAW CAP_NET_BIND_SERVICE
NoNewPrivileges=true
ProtectHome=true
ProtectSystem=full
ReadWritePaths=/etc/vwitch
PrivateTmp=true
DeviceAllow=/dev/net/tun rw
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
