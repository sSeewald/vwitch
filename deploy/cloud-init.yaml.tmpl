#cloud-config
# Generated by "vwitch cloud-init". Installs vwitch {{.Version}} from
# https://github.com/{{.Repo}} on Debian 12+ / Ubuntu 22.04+.
package_update: true
package_upgrade: true
packages:
  - curl
  - ca-certificates
{{- if or .Egresses .NetBirdSetupKey}}
write_files:
{{- range .Egresses}}
  - path: /root/vwitch-egress/{{.Name}}.conf
    permissions: "0600"
    content: |
{{indent 6 .Config}}
{{- end}}
{{- if .NetBirdSetupKey}}
  - path: /root/netbird.env
    permissions: "0600"
    content: |
      NB_SETUP_KEY={{.NetBirdSetupKey}}
      NB_MANAGEMENT_URL={{.NetBirdManagementURL}}
{{- end}}
{{- end}}
runcmd:
{{- if .NetBirdSetupKey}}
  # NetBird for admin access (interface wt0); vwitch never touches its tables
  - curl -fsSL https://pkgs.netbird.io/install.sh | sh
  - . /root/netbird.env && netbird up --setup-key "$NB_SETUP_KEY" ${NB_MANAGEMENT_URL:+--management-url "$NB_MANAGEMENT_URL"} && rm -f /root/netbird.env
{{- end}}
  - curl -fsSL https://github.com/{{.Repo}}/releases/{{if eq .Version "latest"}}latest/download{{else}}download/v{{.Version}}{{end}}/install.sh | sh -s -- {{.InstallArgs}}
{{- range .Egresses}}
  - vwitch egress add {{.Name}} /root/vwitch-egress/{{.Name}}.conf{{if .Resolve}} --resolve {{.Resolve}}{{end}} && rm -f /root/vwitch-egress/{{.Name}}.conf
{{- end}}
  - vwitch doctor || true
final_message: "vwitch installed. Admin password: {{if .AdminPasswordHash}}as chosen{{else}}/root/vwitch-admin-password{{end}}. Add clients with: vwitch client add <name> --qr"
